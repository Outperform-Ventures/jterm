      "compare": true
    },
    {
      "name": "goto-layout",
      "args": ["goto-layout", "tall"],
      "compare": true
    },
    {
      "name": "last-used-layout",
      "args": ["last-used-layout"],
      "compare": true
    },
    {
      "name": "set-enabled-layouts",
      "args": ["set-enabled-layouts", "tall,grid"],
      "compare": true
    },
    {
